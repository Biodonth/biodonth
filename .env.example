# ── Meta Pixel + Conversions API ──────────────────────────────────────────────
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=        # optional — remove after testing is complete
GRAPH_API_VERSION=v21.0      # check https://developers.facebook.com/docs/graph-api/changelog

# ── Google Sheets relay (Apps Script web app) ─────────────────────────────────
SHEETS_WEBHOOK_URL=          # Apps Script deployment URL (see apps-script/Code.gs)
SHEETS_WEBHOOK_SECRET=       # same value as Script Property SECRET in Apps Script

# ── Clinic WhatsApp ────────────────────────────────────────────────────────────
CLINIC_WHATSAPP=5511950031000  # digits only, with country code 55

# ── Telegram reception alert (optional) ───────────────────────────────────────
TELEGRAM_BOT_TOKEN=          # leave blank to disable
TELEGRAM_CHAT_ID=            # leave blank to disable
